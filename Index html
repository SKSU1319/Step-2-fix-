    affiliateUrl: "#"
  },
  {
    id: 7,
    title: "Android 'System UI Isn't Responding' Black Screen Freeze",
    category: "Android",
    badgeClass: "badge-android",
    step1: "Power Button + Volume Down ko 10-12 second daba kar force restart karein.",
    step2: "Restart ke baad Settings > Apps > Android System WebView ka 'Uninstall Updates' karein aur cache clear karein.",
    affiliateText: "Phone storage almost 95% full?",
    affiliateLinkText: "High Endurance SD Cards",
