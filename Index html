  },
  {
    id: 9,
    title: "Google Chrome 'Aw, Snap!' or STATUS_ACCESS_VIOLATION Crash",
    category: "Windows",
    badgeClass: "badge-windows",
    step1: "Chrome Settings > System me jakar 'Use hardware acceleration when available' ko OFF karein.",
    step2: "Chrome shortcut properties me Target ke end me ek space dekar '--no-sandbox' add karke test karein.",
    affiliateText: "High RAM consumption fix:",
