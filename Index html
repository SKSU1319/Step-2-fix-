    step1: "Settings > Apps > Google Play Store > Storage > Clear Cache aur fir Clear Data karein.",
    step2: "Play Store kholkar Settings > Network Preferences me jakar 'Over any network' select karein.",
    affiliateText: "Low internal storage issue?",
    affiliateLinkText: "Check Best Budget Type-C Flash Drives",
    affiliateUrl: "#"
  },
  {
    id: 2,
    title: "Free Fire / BGMI 'Download Failed Because You May Not Have Purchased This App'",
    category: "Gaming",
    badgeClass: "badge-gaming",
    step1: "File Manager me Android > obb folder check karein; game ka OBB folder sahi package name ke sath exist hona chahiye.",
    step2: "Phone Settings > App Management > Game > Permissions me jakar 'Storage / All Files Access' allow karein.",
    affiliateText: "Facing high ping spikes?",
    affiliateLinkText: "Check Gaming VPN & DNS Tweaks",
    affiliateUrl: "#"
  },
  {
    id: 3,
    title: "Windows Update Error 0x80070002 or 0x80070003",
    category: "Windows",
    badgeClass: "badge-windows",
    step1: "Win + R dabayein, type karein 'services.msc', Windows Update service ko dhoondh kar 'Stop' karein.",
    step2: "C:\\Windows\\SoftwareDistribution folder me jakar sara data delete karein, fir service wapas 'Start' karein.",
    affiliateText: "Speed up slow boot time?",
    affiliateLinkText: "View Top NVMe SSD Deals",
    affiliateUrl: "#"
  },
  {
    id: 4,
    title: "5G Smartphone Automatic Drop to 4G LTE Repeatedly",
    category: "Android",
    badgeClass: "badge-android",
    step1: "Settings > Mobile Network > SIM 1 > Preferred network type ko '5G/4G/3G/2G (Auto)' par set karein.",
    step2: "Battery Settings me check karein; agar 'Smart 5G' ya 'Power Saving 5G' on hai to use OFF karein taaki signal force 5G rahe.",
    affiliateText: "Weak room network?",
    affiliateLinkText: "Explore 5G Wi-Fi Mesh Routers",
    affiliateUrl: "#"
  },
  {
    id: 5,
    title: "Discord / In-Game Voice Chat Mic Not Picking Up Voice (Mobile/PC)",
    category: "Gaming",
    badgeClass: "badge-gaming",
    step1: "Audio settings me Input Mode ko 'Voice Activity' se badal kar testing ke liye 'Push to Talk' karein.",
    step2: "Phone/Windows Privacy Settings me Microphone Access on karein aur app ko 'Exclusive Mode' band karein.",
    affiliateText: "Clear noise-cancelling mics?",
    affiliateLinkText: "Best Budget Gaming Earphones",
    affiliateUrl: "#"
  },
  {
    id: 6,
    title: "Windows 'No Internet, Secured' Wi-Fi Error",
    category: "Windows",
    badgeClass: "badge-windows",
    step1: "CMD ko Run as Administrator karein aur type karein: 'netsh winsock reset' aur enter dabayein.",
    step2: "Agli command run karein: 'ipconfig /flushdns' aur system ko restart karein.",
    affiliateText: "Weak laptop Wi-Fi card?",
