    affiliateUrl: "#"
  },
  {
    id: 10,
    title: "Bluetooth Earbuds Audio Delay / Sound Lag While Watching Videos",
    category: "Android",
    badgeClass: "badge-android",
    step1: "Developer Options kholen aur 'Bluetooth Audio Codec' ko SBC/AAC se badal kar 'aptX' ya 'LDAC' (agar supported ho) set karein.",
    step2: "Earbuds reset karein (dono buds ko case me rakh kar 10 second press hold) aur fir fresh pair karein.",
    affiliateText: "Low-latency wireless buds:",
    affiliateLinkText: "Explore 40ms Ultra Low Latency TWS",
    affiliateUrl: "#"
  }
];

let activeCategory = 'All';

function renderCards(data) {
  const container = document.getElementById('cardsList');
  const emptyState = document.getElementById('emptyState');
  container.innerHTML = '';

  if (data.length === 0) {
    emptyState.style.display = 'block';
    return;
  }
  emptyState.style.display = 'none';

  data.forEach(item => {
    const card = document.createElement('div');
    card.className = 'error-card';
    card.innerHTML = `
      <div class="card-meta">
        <span class="platform-badge ${item.badgeClass}">${item.category}</span>
      </div>
      <div class="card-title">${item.title}</div>
      <ol class="steps-list">
        <li>${item.step1}</li>
        <li>${item.step2}</li>
      </ol>
      <div class="monetize-strip">
        <span>${item.affiliateText}</span>
        <a href="${item.affiliateUrl}" target="_blank">${item.affiliateLinkText} &rarr;</a>
      </div>
    `;
    container.appendChild(card);
  });
}

// Live Search logic
document.getElementById('searchBar').addEventListener('input', (e) => {
  const query = e.target.value.toLowerCase().trim();
  const filtered = errorDatabase.filter(item => {
    const matchCategory = (activeCategory === 'All' || item.category === activeCategory);
    const matchQuery = item.title.toLowerCase().includes(query) ||
                       item.step1.toLowerCase().includes(query) ||
                       item.step2.toLowerCase().includes(query);
    return matchCategory && matchQuery;
  });
  renderCards(filtered);
});

// Category Filter logic
function filterCategory(cat) {
  activeCategory = cat;
  document.querySelectorAll('.pill').forEach(btn => {
    btn.classList.toggle('active', btn.innerText.includes(cat));
  });
  
  const query = document.getElementById('searchBar').value.toLowerCase().trim();
  const filtered = errorDatabase.filter(item => {
    const matchCategory = (activeCategory === 'All' || item.category === activeCategory);
    const matchQuery = item.title.toLowerCase().includes(query) ||
                       item.step1.toLowerCase().includes(query) ||
                       item.step2.toLowerCase().includes(query);
    return matchCategory && matchQuery;
  });
  renderCards(filtered);
}

// Initial render
renderCards(errorDatabase);
</script>

</body>
</html>
